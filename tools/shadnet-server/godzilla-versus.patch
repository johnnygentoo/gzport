+ErrorType ClientSession::CmdSetRoomMemberDataInternal(StreamExtractor& data, QByteArray& reply) {
+    shadnet::SetRoomMemberDataInternalRequest req;
+    if (!decodeProto(req, data) || data.error())
+        return ErrorType::Malformed;
+
+    const uint64_t roomId = req.room_id();
+    shadnet::MatchingRoomMemberData memberPb;
+    {
+        QWriteLocker lk(&m_shared->matching.roomsLock);
+        auto roomIt = m_shared->matching.rooms.find({m_matching.matchingKey, roomId});
+        if (roomIt == m_shared->matching.rooms.end())
+            return ErrorType::RoomMissing;
+        Room& room = roomIt.value();
+        RoomMember* self = room.findByNpidMut(m_info.npid);
+        if (!self)
+            return ErrorType::RoomMissing;
+        RoomMember* target = self;
+        if (req.member_id() != 0 && req.member_id() != self->memberId) {
+            // Another member's data: the owner's privilege.
+            if (self->memberId != room.ownerMemberId)
+                return ErrorType::Unauthorized;
+            auto it = room.members.find(static_cast<uint16_t>(req.member_id()));
+            if (it == room.members.end())
+                return ErrorType::InvalidInput;
+            target = &it.value();
+        }
+
+        if (req.team_id() != 0)
+            target->teamId = static_cast<uint8_t>(req.team_id());
+        const uint32_t filter =
+            req.flag_filter() & ~Matching2::ORBIS_NP_MATCHING2_ROOMMEMBER_FLAG_ATTR_OWNER;
+        target->flagAttr = (target->flagAttr & ~filter) | (req.flag_attr() & filter);
+        for (int i = 0; i < req.bin_attrs_size(); ++i) {
+            const auto& a = req.bin_attrs(i);
+            if (a.attr_id() != Matching2::ORBIS_NP_MATCHING2_ROOMMEMBER_BIN_ATTR_INTERNAL_1_ID)
+                continue;
+            auto& slot = target->memberBinAttr;
+            slot.set = true;
+            slot.attrId = static_cast<uint16_t>(a.attr_id());
+            slot.data = QByteArray(a.data().data(), static_cast<int>(a.data().size()));
+            slot.updateDate = std::max<uint64_t>(slot.updateDate + 1, MatchingTimestampUsec());
+        }
+        memberPb = BuildRoomMemberData(*target);
+        qInfo() << "SetRoomMemberDataInternal: room=" << roomId << "member=" << target->memberId
+                << "by" << m_info.npid << "flags=" << Qt::hex << target->flagAttr
+                << "binAttrs=" << req.bin_attrs_size();
+        qDebug() << "  member data=" << target->memberBinAttr.data.toHex();
+    }
+
+    // UpdatedRoomMemberDataInternal (0x1107) to every member, the sender too: the sender's own
+    // entry changes only by this event (GODZILLA's lobby counts its own ready flag with the others').
+    {
+        shadnet::NotifyRoomEvent pb;
+        pb.set_room_id(roomId);
+        pb.set_event(Matching2::ORBIS_NP_MATCHING2_ROOM_EVENT_UPDATED_ROOM_MEMBER_DATA_INTERNAL);
+        pb.set_event_cause(Matching2::ORBIS_NP_MATCHING2_EVENT_CAUSE_SERVER_OPERATION);
+        *pb.mutable_member() = memberPb;
+        const auto buildPacket = [pb](uint32_t contextId) {
+            auto event = pb;
+            event.set_ctx_id(contextId);
+            QByteArray payload;
+            appendProto(payload, event);
+            return BuildNotification(NotificationType::RoomEvent, payload);
+        };
+        NotifyRoomMembers(buildPacket, m_matching.matchingKey, roomId);
+    }
+
+    shadnet::SetRoomMemberDataInternalReply rep;
+    rep.set_room_id(roomId);
+    appendProto(reply, rep);
+    return ErrorType::NoError;
+}
