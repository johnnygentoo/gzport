 ErrorType ClientSession::CmdSetRoomDataExternal(StreamExtractor& data, QByteArray& reply) {
     shadnet::SetRoomDataExternalRequest req;
     if (!decodeProto(req, data) || data.error())
@@ -1578,12 +1656,30 @@ void ClientSession::DoLeaveRoom(uint64_t roomId) {
 
 // ── Disconnect cleanup ────────────────────────────────────────────────────────
 
+// Every room this player is still in: the session tracks one room, but a game that creates or
+// joins another without leaving (GODZILLA backing out of its versus lobby) leaves the first one
+// behind, a member the others keep seeing and a room its own next search finds.
+void ClientSession::LeaveAllRooms(const char* why) {
+    QVector<uint64_t> roomIds;
+    {
+        QReadLocker lk(&m_shared->matching.roomsLock);
+        for (auto it = m_shared->matching.rooms.cbegin(); it != m_shared->matching.rooms.cend();
+             ++it) {
+            if (it.key().first == m_matching.matchingKey && it.value().findByNpid(m_info.npid))
+                roomIds.append(it.key().second);
+        }
+    }
+    for (const uint64_t roomId : roomIds) {
+        qInfo() << "Leaving room" << roomId << "for" << m_info.npid << "(" << why << ")";
+        DoLeaveRoom(roomId);
+    }
+}
+
 void ClientSession::CleanupMatchingOnDisconnect() {
     if (!m_matching.initialized)
         return;
 
-    if (m_matching.roomId != 0)
-        DoLeaveRoom(m_matching.roomId);
+    LeaveAllRooms("disconnect");
 
     qInfo() << "Matching cleanup for" << m_info.npid;
 }
